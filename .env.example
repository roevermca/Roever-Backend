# Spring Boot Server Port
PORT=8080

# Local Machine MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ams_db
MYSQL_USER=root
MYSQL_PASSWORD=

# Or full JDBC URL:
# MYSQL_URL=jdbc:mysql://localhost:3306/ams_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true&cachePrepStmts=true&prepStmtCacheSize=250&prepStmtCacheSqlLimit=2048&useServerPrepStmts=true

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=roever-ams
FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
